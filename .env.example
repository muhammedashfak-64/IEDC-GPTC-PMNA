# ==============================================================================
# IEDC GPTC PERINTHALMANNA — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LIVE SUPABASE DATABASE & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# ------------------------------------------------------------------------------
# 2. AI STUDENT LEAD & FACULTY PORTRAIT STUDIO (GENUINE AI PROVIDERS)
# ------------------------------------------------------------------------------
# The website features an AI Portrait Studio for transforming ordinary member
# photos into professional IEDC portraits (formal dark shirt / kurta, natural
# crossed-arm pose, dark IEDC lanyard, and NO ID badge on clean transparency).
#
# To enable real generative clothing and crossed-arm pose transformation,
# configure any of the following supported AI provider keys in .env.local:
#
# Option A: Replicate API (Recommended for Flux-PuLID / InstantID face preservation)
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Option B: OpenAI API (For DALL-E 3 image generation & edits)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option C: Stability AI (For Stable Diffusion 3 / Inpainting)
# Get your key at: https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# Option D: Remove.bg API (For cloud-based portrait background cutout)
# Get your key at: https://www.remove.bg/api
REMOVE_BG_API_KEY=

# NOTE: If no generative AI provider key is configured, the system will
# transparently explain that an AI provider is required for clothing/pose changes,
# and offers an instant 1-click fallback to extract a clean background cutout
# with the official IEDC lanyard overlay using the built-in local Sharp engine!
